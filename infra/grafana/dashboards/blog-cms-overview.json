{
  "id": null,
  "uid": "blog-cms-overview",
  "title": "Blog CMS — Tổng quan hệ thống",
  "tags": [
    "blog-cms",
    "monitoring"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Trạng thái thu thập metrics",
      "description": "1: scrape thành công; 0: scrape thất bại. Đây là trạng thái target giám sát.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-cms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-cms-prometheus"
          },
          "expr": "up{project=\"blog-cms\"}",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Nginx — yêu cầu mỗi giây",
      "description": "Tổng yêu cầu qua Nginx, gồm cả kiểm tra sức khỏe và trang thống kê.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-cms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-cms-prometheus"
          },
          "expr": "rate(nginx_http_requests_total{job=\"nginx\",project=\"blog-cms\"}[2m])",
          "legendFormat": "Nginx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Container — CPU",
      "description": "100% tương ứng sử dụng một lõi CPU; có thể vượt 100% khi dùng nhiều lõi.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-cms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-cms-prometheus"
          },
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",project=\"blog-cms\"}[2m])) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Container — RAM working set",
      "description": "Working set của từng service; đơn vị tự đổi thành MiB/GiB.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-cms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-cms-prometheus"
          },
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{job=\"cadvisor\",project=\"blog-cms\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
