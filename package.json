{
  "name": "blog-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống Blog CMS cho môn Triển khai và Quản trị Hệ thống Phần mềm",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-admin": "node scripts/create-admin.js",
    "create-author": "node scripts/create-author.js"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "argon2": "0.45.1",
    "ejs": "7.0.1",
    "express": "5.3.0",
    "express-mysql-session": "3.0.3",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "google-auth-library": "11.3.0",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.1.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
