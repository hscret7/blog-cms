<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Liên kết Google | Blog CMS</title><link rel="stylesheet" href="/css/site.css?v=3"></head><body><%- include('../partials/header') %><main id="main-content" class="account-form-page"><h1>Phương thức đăng nhập</h1><p>Email website: <%= user.email %></p>
<% if(identity) { %><p>Đã liên kết Google.</p><% if(user.has_password) { %><form class="form-panel" method="post" action="/account/google/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="unlink-password">Mật khẩu website hiện tại</label><input id="unlink-password" name="current_password" type="password" autocomplete="current-password" required><button type="button" data-toggle-password="unlink-password" class="password-toggle">Hiện mật khẩu</button><button>Gỡ liên kết Google</button></form><% } else { %><p>Google là phương thức đăng nhập duy nhất. <a href="/forgot-password">Đặt mật khẩu qua email</a> trước khi gỡ liên kết.</p><% } %>
<% } else { %><p>Liên kết Google sau khi xác nhận mật khẩu website. Bạn cần chọn tài khoản Google cùng email.</p><form class="form-panel" method="post" action="/account/google/link"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="link-password">Mật khẩu website hiện tại</label><input id="link-password" name="current_password" type="password" autocomplete="current-password" required><button type="button" data-toggle-password="link-password" class="password-toggle">Hiện mật khẩu</button><button>Tiếp tục liên kết Google</button></form><% } %>
</main><%- include('../partials/footer') %></body></html>
