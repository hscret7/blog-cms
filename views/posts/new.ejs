<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tạo bài nháp | Blog CMS</title>
  <link rel="stylesheet" href="/css/site.css?v=1">
  <script src="/js/ui.js?v=1" defer></script>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content">
    <h1>Tạo bài nháp</h1>
    <p>Tác giả: <%= user.name %>.</p>
    <p>Bài mới được lưu ở trạng thái DRAFT, chưa hiển thị công khai.</p>

    <%- include('form', {
      formAction: '/manage/posts',
      submitLabel: 'Lưu bài nháp'
    }) %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
