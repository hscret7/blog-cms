<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý bài viết | Blog CMS</title>
  <link rel="stylesheet" href="/css/site.css?v=2">
  <script src="/js/ui.js?v=2" defer></script>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content">
    <h1>Quản lý bài viết</h1>
    <% if (typeof query !== 'undefined') { %><%- include('../partials/list-filters', { kind: 'posts' }) %><% } %>
    <p>Xin chào, <%= user.name %>.</p>

    <% if (user.role === 'ADMIN') { %>
      <p>Bạn đang xem bài viết của tất cả tác giả.</p>
    <% } else { %>
      <p>Bạn đang xem các bài viết của mình.</p>
    <% } %>

    <p class="page-actions">
      <a href="/manage/posts/new">Tạo bài nháp</a> | <a href="/manage/comments">Bình luận trên bài của tôi</a> |
      <a href="/account">Về tài khoản</a>
    </p>

    <p>Tổng số bài: <%= total %>.</p>

    <% if (posts.length === 0) { %>
      <p>Chưa có bài viết.</p>
    <% } else { %>
      <div class="table-wrap" role="region" aria-label="Danh sách quản lý" tabindex="0">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Danh mục</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(function(post) { %>
            <tr>
              <td><%= post.id %></td>
              <td><%= post.title %></td>
              <td><%= post.author_name %></td>
              <td><%= post.category_name %></td>
              <td><span class="badge <%= post.status === 'DRAFT' ? 'badge-draft' : '' %>"><%= post.status === 'DRAFT' ? 'Nháp' : 'Đã xuất bản' %></span></td>
              <td>
                <a href="/manage/posts/<%= post.id %>/edit">Sửa / ảnh</a>
                <a href="/manage/posts/<%= post.id %>/history">Lịch sử</a>
                <% if (post.status === 'PUBLISHED') { %><a href="/posts/<%= post.slug %>">Xem bài</a><% } %>

                <% if (post.status === 'DRAFT') { %>
                  <form
                    action="/manage/posts/<%= post.id %>/publish"
                    method="post"
                    style="display: inline;"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Xuất bản</button>
                  </form>
                <% } else if (post.status === 'PUBLISHED') { %>
                  <form
                    action="/manage/posts/<%= post.id %>/unpublish"
                    method="post"
                    style="display: inline;"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Chuyển về nháp</button>
                  </form>
                <% } %>

                  <form
                    action="/manage/posts/<%= post.id %>/delete"
                    method="post"
                    style="display: inline;"
                    onsubmit="return confirm('Xóa vĩnh viễn bài viết này?');"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Xóa</button>
                  </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>

    <% if (typeof previousUrl !== 'undefined') { %><%- include('../partials/pagination') %><% } %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
