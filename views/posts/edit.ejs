<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sửa bài viết | Blog CMS</title>
  <link rel="stylesheet" href="/css/site.css?v=4">

</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content">
    <h1>Sửa bài #<%= post.id %></h1>
    <p><a href="/manage/posts/<%= post.id %>/history">Xem lịch sử sửa bài</a></p>
    <p>Trạng thái hiện tại: <%= post.status %>.</p>
    <p>Lưu nội dung không thay đổi tác giả hoặc trạng thái xuất bản.</p>

    <%- include('form', {
      formAction: '/manage/posts/' + post.id + '/update',
      submitLabel: 'Lưu thay đổi'
    }) %>
    <p class="page-actions"><a href="/manage/posts">← Về danh sách bài viết</a></p>
    <section class="cover-panel" aria-labelledby="cover-heading">
      <h2 id="cover-heading">Ảnh đại diện</h2>

      <% if (post.cover_path) { %>
        <p>Ảnh hiện tại:</p>

        <img
          src="/media/posts/<%= post.id %>/cover"
          alt="Ảnh đại diện bài viết"
          width="480"
        >

        <form
          method="post"
          action="/manage/posts/<%= post.id %>/cover/remove"
          onsubmit="return confirm('Bạn có chắc muốn gỡ ảnh đại diện?');"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >
          <button type="submit">Gỡ ảnh đại diện</button>
        </form>
      <% } else { %>
        <p>Bài viết chưa có ảnh đại diện.</p>
      <% } %>

      <form
        method="post"
        action="/manage/posts/<%= post.id %>/cover"
        enctype="multipart/form-data"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <p>
          <label for="cover">Chọn ảnh JPEG, PNG hoặc WebP</label>
          <input
            id="cover"
            name="cover"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            required
          >
        </p>

        <p>
          Tối đa 5 MiB và 20 triệu pixel.
          Ảnh được chuyển sang WebP, giữ tỷ lệ và thu nhỏ
          về kích thước tối đa 1600 × 1600 pixel.
        </p>

        <button type="submit">
          <%= post.cover_path ? 'Thay ảnh đại diện' : 'Tải ảnh đại diện' %>
        </button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
