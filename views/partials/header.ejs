<% const viewer = typeof currentUser !== 'undefined' ? currentUser : (typeof user !== 'undefined' ? user : null); %>
<% const activePath = typeof currentPath === 'string' ? currentPath : ''; %>
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<header class="site-header" data-session-user="<%= viewer?.id || 0 %>">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Blog CMS — Trang chủ"><span class="brand-mark" aria-hidden="true">B.</span><span>Blog<span class="brand-light"> / CMS</span></span></a>
    <nav class="site-nav" aria-label="Điều hướng chính">
      <a href="/" <%- activePath === '/' ? 'aria-current="page"' : '' %>>Đọc blog</a>
      <% if (viewer) { %>
        <% if (['ADMIN', 'AUTHOR'].includes(viewer.role)) { %>
        <a href="/manage/posts" <%- activePath.startsWith('/manage/posts') ? 'aria-current="page"' : '' %>>Bài viết</a>
        <% } %>
        <% if (viewer.role === 'ADMIN') { %>
          <a href="/admin/categories" <%- activePath.startsWith('/admin/categories') ? 'aria-current="page"' : '' %>>Danh mục</a>
          <a href="/admin/users" <%- activePath.startsWith('/admin/users') ? 'aria-current="page"' : '' %>>Người dùng</a>
          <a href="/admin/comments" <%- activePath === '/admin/comments' ? 'aria-current="page"' : '' %>>Bình luận</a>
          <a href="/admin/author-requests" <%- activePath === '/admin/author-requests' ? 'aria-current="page"' : '' %>>Duyệt tác giả</a>
          <div class="nav-dropdown">
            <button type="button" class="nav-dropdown-btn <%- (activePath === '/admin/activity' || activePath === '/admin/system-logs') ? 'active' : '' %>" aria-haspopup="true" aria-expanded="false">
              Nhật ký hệ thống <span class="nav-arrow" aria-hidden="true">▾</span>
            </button>
            <div class="nav-dropdown-menu">
              <a href="/admin/activity" <%- activePath === '/admin/activity' ? 'aria-current="page"' : '' %>>Nhật ký hoạt động</a>
              <a href="/admin/system-logs" <%- activePath === '/admin/system-logs' ? 'aria-current="page"' : '' %>>Nhật ký kỹ thuật</a>
            </div>
          </div>
          <a href="/admin" <%- activePath === '/admin' ? 'aria-current="page"' : '' %>>Quản trị</a>
        <% } %>
        <a href="/notifications" <%- activePath === '/notifications' ? 'aria-current="page"' : '' %>>Thông báo (<%= typeof unreadCount === 'number' ? unreadCount : 0 %>)</a>
        <a class="nav-account" href="/account" <%- activePath === '/account' ? 'aria-current="page"' : '' %>><%= viewer.name %></a>
      <% } else { %>
        <a href="/register">Đăng ký</a>
        <a href="/account">Không gian cá nhân</a>
        <a class="nav-account" href="/login">Đăng nhập <span aria-hidden="true">↗</span></a>
      <% } %>
    </nav>
  </div>
</header>

<%- include('feedback') %>
<script src="/js/ui.js?v=4" defer></script>
