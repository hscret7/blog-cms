<form class="filter-bar" method="get">
<p><label for="list-q">Tìm kiếm</label><input id="list-q" name="q" value="<%= filters.q %>" placeholder="<%= kind==='posts'?'Tiêu đề bài viết':kind==='users'?'Tên hoặc email':'Tên hoặc slug' %>"></p>
<p><label for="list-sort">Sắp xếp</label><select id="list-sort" name="sort"><% for(const [key,label]of [['newest','Mới nhất'],['oldest','Cũ nhất'],['title','Tên / tiêu đề A–Z']]) { %><option value="<%= key %>" <%= filters.sort===key?'selected':'' %>><%= label %></option><% } %></select></p>
<% if(kind!=='categories') { %><p><label for="list-status">Trạng thái</label><select id="list-status" name="status"><option value="">Tất cả</option><% for(const key of kind==='posts'?['DRAFT','PUBLISHED']:['ACTIVE','LOCKED']) { %><option value="<%= key %>" <%= query.status===key?'selected':'' %>><%= {DRAFT:'Nháp',PUBLISHED:'Đã xuất bản',ACTIVE:'Hoạt động',LOCKED:'Đã khóa'}[key] %></option><% } %></select></p><% } %>
<% if(kind==='users') { %><p><label for="list-role">Vai trò</label><select id="list-role" name="role"><option value="">Tất cả</option><% for(const role of ['READER','AUTHOR','ADMIN']) { %><option value="<%= role %>" <%= query.role===role?'selected':'' %>><%= role %></option><% } %></select></p><% } %>
<% if(kind==='posts') { %>
<p><label for="list-category">Danh mục</label><select id="list-category" name="category_id"><option value="">Tất cả danh mục</option><% for(const option of (typeof categoryOptions !== 'undefined' ? categoryOptions : [])) { %><option value="<%= option.id %>" <%= query.category_id===String(option.id)?'selected':'' %>><%= option.name %></option><% } %></select></p>
<% if(user.role==='ADMIN') { %><p><label for="list-author">Tác giả</label><select id="list-author" name="author_id"><option value="">Tất cả tác giả</option><% for(const option of (typeof authorOptions !== 'undefined' ? authorOptions : [])) { %><option value="<%= option.id %>" <%= query.author_id===String(option.id)?'selected':'' %>><%= option.name %></option><% } %></select></p><% } %><% } %>
<button>Lọc</button><a href="<%= kind==='posts'?'/manage/posts':kind==='users'?'/admin/users':'/admin/categories' %>">Xóa bộ lọc</a>
</form>
