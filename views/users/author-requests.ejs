<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Duyệt quyền tác giả | Blog CMS</title><link rel="stylesheet" href="/css/site.css?v=3"></head><body><%- include('../partials/header') %><main id="main-content"><h1>Yêu cầu quyền tác giả</h1>
<% if(typeof errorMessage==='string'&&errorMessage) { %><p role="alert"><%= errorMessage %></p><% } %>
<form class="filter-bar" method="get"><p><label for="q">Tên hoặc email</label><input id="q" name="q" value="<%= query.q||'' %>"></p><p><label for="status">Trạng thái</label><select id="status" name="status"><option value="">Tất cả</option><% for(const [key,label]of [['PENDING','Chờ duyệt'],['APPROVED','Được duyệt'],['REJECTED','Bị từ chối']]) { %><option value="<%= key %>" <%= query.status===key?'selected':'' %>><%= label %></option><% } %></select></p><button>Lọc</button><a href="/admin/author-requests">Xóa bộ lọc</a></form>
<p>Có <%= total %> yêu cầu.</p>
<% for(const row of rows) { %><section class="comment-card"><h2><%= row.name %></h2><p><%= row.email %> · <%= row.status %></p><p><%= row.reason %></p><% if(row.review_note) { %><p><%= row.review_note %></p><% } %>
<% if(row.status==='PENDING') { %><form method="post" action="/admin/author-requests/<%= row.user_id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="note-<%= row.user_id %>">Lời nhắn (bắt buộc khi từ chối)</label><textarea id="note-<%= row.user_id %>" name="note"><%= typeof formNote==='string'?formNote:'' %></textarea><button name="status" value="APPROVED">Duyệt AUTHOR</button><button class="button-secondary" name="status" value="REJECTED">Từ chối</button></form><% } %></section><% } %>
<%- include('../partials/pagination') %></main><%- include('../partials/footer') %></body></html>
