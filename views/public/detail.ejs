<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= post.title %> | Blog CMS</title>
  <link rel="stylesheet" href="/css/site.css?v=1">
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content">
    <article class="reader">
      <a class="back-link" href="/">← Về trang chủ</a>
      <div class="category-label"><a href="/?category_id=<%= post.category_id %>"><%= post.category_name %></a></div>
      <h1><%= post.title %></h1>
      <div class="reader-meta"><p>Tác giả: <strong><%= post.author_name %></strong></p><p>Xuất bản: <%= publishedAtText %> — giờ Việt Nam</p></div>
      <% if (post.cover_path) { %><img class="reader-cover" src="/media/posts/<%= post.id %>/cover" alt="Ảnh đại diện: <%= post.title %>"><% } %>
      <div class="post-content"><%= post.content %></div>
    </article>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
