<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sửa bình luận | Blog CMS</title><link rel="stylesheet" href="/css/site.css?v=4"></head><body><%- include('../partials/header') %><main id="main-content" class="account-form-page"><h1>Kiểm tra nội dung bình luận</h1><p><%= post.title %></p><p role="alert"><%= errorMessage %></p><form class="form-panel" action="<%= formAction %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="parent_id" value="<%= formData.parent_id||'' %>"><label for="content">Nội dung (1–2.000 ký tự)</label><textarea id="content" name="content" required><%= formData.content||'' %></textarea><button>Gửi lại bình luận</button><a href="/posts/<%= post.slug %>">Về bài viết</a></form></main><%- include('../partials/footer') %></body></html>
