<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cuộc trao đổi | Blog CMS</title><link rel="stylesheet" href="/css/site.css?v=3"></head><body><%- include('../partials/header') %><main id="main-content" class="reader">
<h1>Cuộc trao đổi</h1><p><a href="/posts/<%= post.slug %>"><%= post.title %></a></p>
<%- include('../partials/comment',{comment:root}) %>
<h2>Câu trả lời (<%= total %>)</h2>
<% for(const reply of rows) { %><section class="comment-card" id="comment-<%= reply.id %>"><strong><%= reply.name %></strong><p class="post-content"><%= reply.content %></p><small><%= new Intl.DateTimeFormat('vi-VN',{dateStyle:'short',timeStyle:'short',timeZone:'Asia/Ho_Chi_Minh'}).format(reply.created_at) %></small></section><% } %>
<nav class="pagination" aria-label="Phân trang câu trả lời"><% if(filters.page>1) { %><a href="?page=<%= filters.page-1 %>">Trang trước</a><% } %><p>Trang <%= filters.page %> / <%= totalPages %></p><% if(filters.page<totalPages) { %><a href="?page=<%= filters.page+1 %>">Trang sau</a><% } %></nav>
</main><%- include('../partials/footer') %></body></html>
