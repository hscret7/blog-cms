# Tên dự án Docker Compose
COMPOSE_PROJECT_NAME=blog-cms

# MySQL
MYSQL_DATABASE=blog_cms
MYSQL_USER=blog_app
MYSQL_PASSWORD=THAY_BANG_MAT_KHAU_UNG_DUNG
MYSQL_ROOT_PASSWORD=THAY_BANG_MAT_KHAU_ROOT

# Cổng truy cập từ máy đang phát triển
MYSQL_HOST_PORT=13319
PHPMYADMIN_HOST_PORT=18091

# Kết nối database từ ứng dụng chạy trực tiếp trong WSL
DB_HOST=127.0.0.1
DB_PORT=13319