# Tên dự án Docker Compose
COMPOSE_PROJECT_NAME=blog-cms

# MySQL
MYSQL_DATABASE=blog_cms
MYSQL_USER=blog_app
MYSQL_PASSWORD=THAY_BANG_MAT_KHAU_UNG_DUNG
MYSQL_ROOT_PASSWORD=THAY_BANG_MAT_KHAU_ROOT

# Cổng truy cập từ máy đang phát triển
MYSQL_HOST_PORT=13319
PHPMYADMIN_HOST_PORT=18091

# Kết nối database từ ứng dụng chạy trực tiếp trong WSL
DB_HOST=127.0.0.1
DB_PORT=13319

# Khóa ký cookie phiên đăng nhập; tạo giá trị ngẫu nhiên trong .env
SESSION_SECRET=THAY_BANG_KHOA_NGAU_NHIEN

# Chạy trực tiếp trong WSL: để trống, không tin reverse proxy.
# Compose sẽ đặt IP Nginx cho container app.
TRUSTED_PROXY_IP=

# Email: thay trên .env thật, không commit thông tin đăng nhập SMTP.
PUBLIC_BASE_URL=http://localhost:18090
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
